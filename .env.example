# ---------------------------------------------------------------------------
# CampusOrbit environment variables
# Copy this file to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key.
# SERVER ONLY. Never expose this to the browser.
# Used exclusively by admin-only server actions (user management, seeding).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and shareable portfolio links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CampusOrbit AI (optional)
# ---------------------------------------------------------------------------
# CampusOrbit AI always answers from a retrieval context built out of the
# signed-in student's own CampusOrbit data (RAG). If no model key is present
# the assistant falls back to the built-in deterministic grounded reasoner,
# so the demo works with zero external services.
#
# Supported providers: openai | groq | none
CAMPUSORBIT_AI_PROVIDER=none
CAMPUSORBIT_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=

# Shows the one-click demo account panel on /login (seeded dataset only).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
