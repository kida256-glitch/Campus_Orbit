# ---------------------------------------------------------------------------
# CampusOrbit — environment variables
#
# QUICK START (hosted Supabase — no Docker needed)
# -------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Copy your Project URL and anon key from
#    Project Settings → API
# 3. Run:  npm run sb -- link --project-ref <your-project-ref>
#          npm run sb -- db push
# 4. Fill in the values below and save as .env.local
# 5. npm run start:prod
#
# ALTERNATIVE (local Docker stack)
# ---------------------------------
# Run `npm run db:start` — it applies migrations and seeds automatically.
# The keys below are pre-filled with the fixed local demo values.
# ---------------------------------------------------------------------------

# Supabase project URL — e.g. https://abcdefghijklm.supabase.co
# Local Docker default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Never expose to the browser.
# Used for admin server actions and seeding. Leave blank if not needed.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for auth redirects and shareable portfolio links.
# Change to your Vercel / production URL when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CampusOrbit AI (optional — the app works fully without this)
# ---------------------------------------------------------------------------
# The built-in deterministic reasoner requires no key and cannot hallucinate.
# Set a provider key only if you want fluent LLM-generated answers.
#
# Supported: openai | groq | none
CAMPUSORBIT_AI_PROVIDER=none
CAMPUSORBIT_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=
